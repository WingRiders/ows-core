{
  "name": "ows-contract-call-harness",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bun scripts/capture-call-randomness.ts",
    "compile": "bun run compile:single && bun run compile:tally && bun run compile:caller && bun run compile:till && bun run compile:payer && bun run compile:vault",
    "compile:single": "compact compile +0.34.0 contracts/single.compact contracts/managed/Single",
    "compile:tally": "compact compile +0.34.0 contracts/tally.compact contracts/managed/Tally",
    "compile:caller": "compact compile +0.34.0 --compact-path contracts/managed contracts/caller.compact contracts/managed/Caller",
    "compile:till": "compact compile +0.34.0 contracts/till.compact contracts/managed/Till",
    "compile:payer": "compact compile +0.34.0 --compact-path contracts/managed contracts/payer.compact contracts/managed/Payer",
    "compile:vault": "compact compile +0.34.0 contracts/vault.compact contracts/managed/Vault"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.5-rc.8",
    "@midnight-ntwrk/compact-runtime": "0.19.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-types": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0-beta.7",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.2",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@scure/base": "2.4.0",
    "graphql": "17.0.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2"
  },
  "overrides": {
    "@midnight-ntwrk/compact-runtime": "0.19.0"
  }
}
